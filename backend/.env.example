# Copy to .env for local runs. Never commit .env.
# On a host, set these as environment variables instead.

# Supabase project URL (Project Settings, API). No trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings, API. The anon key and the service role key stay on the server.
# The app never sees them. The service role key deletes accounts.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only for a project that still signs tokens with the shared HS256 secret
# (Project Settings, API, JWT secret). Leave empty when the project uses signing keys.
SUPABASE_JWT_SECRET=

# The transaction pooler string (Project Settings, Database, Connection string).
# A "?pgbouncer=true" suffix is allowed: the app removes it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Public address of this server. It goes into link previews of invite links.
PUBLIC_BASE_URL=https://api.example.com

# Sign-in methods the app may offer: email, google, apple (comma list).
AUTH_PROVIDERS=email

# Sign in with Apple revocation (App Store rule 4.8). Both must be set, or the
# backend skips the exchange and no Apple grant can be revoked on deletion.
# APPLE_CLIENT_ID is the app's bundle id (in.talkies.talkies).
# APPLE_CLIENT_SECRET is the ES256 client-secret JWT minted from the Apple team
# key (Apple Developer: Keys, then Certificates, Identifiers and Profiles).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Largest number of database connections this process opens. Must be at least 1.
DB_POOL_MAX=10

# Addresses or CIDRs of the proxies in front of this server, comma list.
# X-Forwarded-For is believed only when the request comes from one of these, and
# only for the entries a proxy appended: the leftmost entry is the client's own
# text and is never used. Default 127.0.0.1,::1 trusts a proxy on the same
# machine only. In a container behind a host proxy, set the address the proxy
# connects from, for example TRUSTED_PROXIES=172.17.0.1. Leave it out to trust
# nobody: the socket address is then the only thing the limiter counts.
TRUSTED_PROXIES=127.0.0.1,::1
